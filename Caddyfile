{
  frankenphp {
    num_threads 2
  }
  order cgi-php before file_server
}

:80 {
    root * /app/public
    encode zstd br gzip

    @livewire path /livewire/*
    handle @livewire {
        rewrite * /index.php?{query}
    }

    @static {
        path /build/* *.png *.jpg *.jpeg *.svg *.woff2 *.css *.js
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    php_server
    file_server
}